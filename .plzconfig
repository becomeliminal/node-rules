[please]
version = >=17.27.0

[PluginDefinition]
name = node

[PluginConfig "node_tool"]
ConfigKey = NodeTool
DefaultValue = ///node//third_party/node:node|node
Help = Build label for the Node.js binary, from node_toolchain.
Inherit = true

[PluginConfig "npm_tool"]
ConfigKey = NpmTool
DefaultValue = ///node//third_party/node:node|npm
Help = Build label for the npm CLI, from node_toolchain.
Inherit = true

[PluginConfig "default_version"]
ConfigKey = DefaultVersion
DefaultValue = 22.23.2
Help = Node.js version used when node_toolchain is called without an explicit version.
Inherit = true

[PluginConfig "default_bun_version"]
ConfigKey = DefaultBunVersion
DefaultValue = 1.4.4
Help = Bun version used when bun_toolchain is called without an explicit version.
Inherit = true

[PluginConfig "default_oxlint_version"]
ConfigKey = DefaultOxlintVersion
DefaultValue = 1.91.0
Help = OXLint version used when oxlint_toolchain is called without an explicit version.
Inherit = true

[PluginConfig "bun_tool"]
ConfigKey = BunTool
DefaultValue = ///node//third_party/bun:bun|bun
Help = Build label for the Bun binary, from bun_toolchain.
Inherit = true

[PluginConfig "oxlint_tool"]
ConfigKey = OxlintTool
DefaultValue = ///node//third_party/oxlint:oxlint|oxlint
Help = Build label for the OXLint binary, from oxlint_toolchain.
Inherit = true

[Plugin "node"]
Target = //plugins:node
