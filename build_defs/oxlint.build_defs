"""Pinned OXLint distribution for Please actions."""

# SHA256 values are from the immutable oxlint_v1.91.0 GitHub release assets.
OXLINT_VERSIONS = {
    "1.91.0": {
        "darwin-arm64": ("oxlint-aarch64-apple-darwin.tar.gz", "d1f6037780a4d5e14a32d810083859ae691a5032f789381a5ff9b75f901f90e9"),
        "darwin-x64": ("oxlint-x86_64-apple-darwin.tar.gz", "b422a6a5ffe753b117d7348a80e722ca35183ceb1b6c98766f0de14747727a26"),
        "linux-arm64": ("oxlint-aarch64-unknown-linux-gnu.tar.gz", "c99c0e97edd40d5cd21840831d8eff2d4a5e84ce0cf73a6fdac58aaa9c1e1f20"),
        "linux-x64": ("oxlint-x86_64-unknown-linux-gnu.tar.gz", "de059941526abeaab3c5aafa78caef80e5b4e7197274391d80cde38a1960a916"),
    },
}


def _oxlint_platform():
    if CONFIG.OS not in ["linux", "darwin"]:
        fail("oxlint_toolchain supports linux and darwin only, not " + CONFIG.OS)
    if CONFIG.ARCH == "amd64":
        arch = "x64"
    elif CONFIG.ARCH == "arm64":
        arch = "arm64"
    else:
        fail("oxlint_toolchain does not support architecture " + CONFIG.ARCH)
    return CONFIG.OS + "-" + arch


def oxlint_toolchain(name:str, version:str, visibility:list=["PUBLIC"]):
    """Download verified OXLint and expose its native `oxlint` entry point.

    Usage: oxlint_toolchain(name = "oxlint", version = "1.91.0")
    """
    if version not in OXLINT_VERSIONS:
        fail("No pinned OXLint hashes for " + version + ". Known versions: " +
             ", ".join(sorted(OXLINT_VERSIONS.keys())))
    platform = _oxlint_platform()
    pin = OXLINT_VERSIONS[version][platform]
    archive = pin[0]
    hash = pin[1]
    url = "https://github.com/oxc-project/oxc/releases/download/oxlint_v" + version + "/" + archive
    executable = archive[:-7]
    cmd = " && ".join([
        "curl -fsSL --retry 5 --retry-delay 2 -o oxlint.tar.gz '" + url + "'",
        "digest=$(if command -v sha256sum >/dev/null 2>&1; then sha256sum oxlint.tar.gz | awk '{print $1}'; else openssl dgst -sha256 oxlint.tar.gz | awk '{print $NF}'; fi)",
        "{ [ \"$digest\" = '" + hash + "' ] || { echo 'bad hash for " + url + "' >&2; exit 1; }; }",
        "mkdir -p _archive $OUT",
        "tar -xzf oxlint.tar.gz -C _archive",
        "mv _archive/" + executable + " $OUT/oxlint",
        "chmod +x $OUT/oxlint",
        "rm -f oxlint.tar.gz",
    ])
    return build_rule(
        name = name,
        outs = [name],
        cmd = cmd,
        entry_points = {"oxlint": name + "/oxlint"},
        binary = True,
        local = True,
        sandbox = False,
        visibility = visibility,
        labels = ["oxlint:" + version],
        building_description = "Installing OXLint v" + version + "...",
    )
