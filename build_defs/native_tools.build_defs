"""Pinned native Bun and OXLint executables for Please actions.

The distribution archive is checked before extraction. It is an action input
through the URL and digest in the command, and is not retained as an output.
"""

BUN_VERSIONS = {
    "1.4.4": {
        "darwin-arm64": ("bun-darwin-aarch64.zip", "c240d7f0ccb90c263a849fcdb09b7ee62630d921348ed6aafda86b9d577bc510"),
        "darwin-x64": ("bun-darwin-x64-baseline.zip", "d4a155adfbfd09155eb3ba05c9e3a544f39297d7a68616d3c7759f67ab5c47dc"),
        "linux-arm64": ("bun-linux-aarch64.zip", "baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e"),
        "linux-x64": ("bun-linux-x64-baseline.zip", "e0446eb55995772eb9894bebae9a6be368d985a8b9271ee124486f9946eedd76"),
    },
}

OXLINT_VERSIONS = {
    "1.91.0": {
        "darwin-arm64": ("oxlint-aarch64-apple-darwin.tar.gz", "d1f6037780a4d5e14a32d810083859ae691a5032f789381a5ff9b75f901f90e9"),
        "darwin-x64": ("oxlint-x86_64-apple-darwin.tar.gz", "b422a6a5ffe753b117d7348a80e722ca35183ceb1b6c98766f0de14747727a26"),
        "linux-arm64": ("oxlint-aarch64-unknown-linux-gnu.tar.gz", "c99c0e97edd40d5cd21840831d8eff2d4a5e84ce0cf73a6fdac58aaa9c1e1f20"),
        "linux-x64": ("oxlint-x86_64-unknown-linux-gnu.tar.gz", "de059941526abeaab3c5aafa78caef80e5b4e7197274391d80cde38a1960a916"),
    },
}


def _native_platform():
    if CONFIG.OS not in ["linux", "darwin"]:
        fail("native JS tools support linux and darwin only, not " + CONFIG.OS)
    if CONFIG.ARCH == "amd64":
        arch = "x64"
    elif CONFIG.ARCH == "arm64":
        arch = "arm64"
    else:
        fail("native JS tools do not support architecture " + CONFIG.ARCH)
    return CONFIG.OS + "-" + arch


def _pinned_archive(versions:dict, tool:str, version:str):
    if version not in versions:
        fail("No pinned " + tool + " release " + version + ". Known versions: " +
             ", ".join(sorted(versions.keys())))
    platform = _native_platform()
    pins = versions[version]
    if platform not in pins:
        fail("No pinned " + tool + " archive for " + platform)
    return pins[platform]


def _download_verified(url:str, digest:str):
    """Return a POSIX shell command that fails before extracting a bad archive."""
    return " && ".join([
        "curl -fsSL --retry 5 --retry-delay 2 -o tool.archive '" + url + "'",
        "digest=$(if command -v sha256sum >/dev/null 2>&1; then sha256sum tool.archive | awk '{print $1}'; else openssl dgst -sha256 tool.archive | awk '{print $NF}'; fi)",
        "{ [ \"$digest\" = '" + digest + "' ] || { echo 'bad SHA256 for " + url + "' >&2; exit 1; }; }",
    ])


def bun_toolchain(name:str, version:str="", visibility:list=["PUBLIC"]):
    """Download a pinned Bun binary for the host platform.

    The x64 archives are Bun's baseline builds, which do not require AVX2.
    Consumers use the `bun` entry point, e.g. `:bun|bun`.
    """
    version = version or CONFIG.NODE.DEFAULT_BUN_VERSION
    pin = _pinned_archive(BUN_VERSIONS, "Bun", version)
    archive = pin[0]
    digest = pin[1]
    directory = archive[:-4]
    url = "https://github.com/oven-sh/bun/releases/download/bun-v" + version + "/" + archive
    return build_rule(
        name = name,
        outs = [name],
        local = True,
        sandbox = False,
        cmd = " && ".join([
            _download_verified(url, digest),
            "mkdir -p _archive $OUT",
            "unzip -q tool.archive -d _archive",
            "mv _archive/" + directory + "/bun $OUT/bun",
            "chmod +x $OUT/bun",
            "rm -f tool.archive",
        ]),
        entry_points = {"bun": name + "/bun"},
        binary = True,
        visibility = visibility,
        labels = ["bun:" + version],
        building_description = "Installing Bun...",
    )


def oxlint_toolchain(name:str, version:str="", visibility:list=["PUBLIC"]):
    """Download a pinned OXLint binary for the host platform.

    Consumers use the `oxlint` entry point, e.g. `:oxlint|oxlint`.
    """
    version = version or CONFIG.NODE.DEFAULT_OXLINT_VERSION
    pin = _pinned_archive(OXLINT_VERSIONS, "OXLint", version)
    archive = pin[0]
    digest = pin[1]
    executable = archive[:-7]
    url = "https://github.com/oxc-project/oxc/releases/download/oxlint_v" + version + "/" + archive
    return build_rule(
        name = name,
        outs = [name],
        local = True,
        sandbox = False,
        cmd = " && ".join([
            _download_verified(url, digest),
            "mkdir -p _archive $OUT",
            "tar -xzf tool.archive -C _archive",
            "mv _archive/" + executable + " $OUT/oxlint",
            "chmod +x $OUT/oxlint",
            "rm -f tool.archive",
        ]),
        entry_points = {"oxlint": name + "/oxlint"},
        binary = True,
        visibility = visibility,
        labels = ["oxlint:" + version],
        building_description = "Installing OXLint...",
    )
